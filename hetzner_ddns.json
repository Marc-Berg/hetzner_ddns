{
  "version": "1.1.0",
  "api_key": "****************************************************************",
  "settings": {
    "log_level": "warn",
    "check_updates": false,
    "auto_create_records": false,
    "ipv6_event_monitor": false,
    "ipv6_event_cooldown": 10,
    "ipv6_event_require_global": true
  },
  "defaults": {
    "ttl": 60
  },
  "zones": [
    {
      "domain": "example.com",
      "records": [
        {
          "type": "A/AAAA",
          "name": "@",
          "ttl": 3600,
          "interface": "eth0"
        },
        {
          "type": "A",
          "name": "homelab"
        },
        {
          "name": "media/ftp/data"
        }
      ]
    },
    {
      "domain": "my-proxy.tld",
      "records": [{ "name": "vpn" }]
    }
  ]
}
